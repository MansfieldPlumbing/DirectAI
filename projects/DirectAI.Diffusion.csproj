<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/Diffusion/*.cs" />
    <Compile Include="../src/Host/WindowsOnly.cs" />
    <ProjectReference Include="DirectAI.Core.csproj" />
    <ProjectReference Include="DirectAI.DirectML.csproj" />
    <None Include="../src/Diffusion/plugin.json" Link="plugin.json" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="../src/Diffusion/plugin.json" LogicalName="DirectAI.plugin.json" />
  </ItemGroup>
</Project>